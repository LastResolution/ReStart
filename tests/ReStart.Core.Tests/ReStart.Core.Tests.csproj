<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ReStart.Core\ReStart.Core.csproj" />
    <ProjectReference Include="..\..\src\ReStart.TileHost\ReStart.TileHost.csproj" />
    <Compile Include="..\..\src\ReStart.App\Services\StartupRegistration.cs" Link="StartupRegistration.cs" />
    <Compile Include="..\..\src\ReStart.App\Services\ExplorerPinRegistration.cs" Link="ExplorerPinRegistration.cs" />
    <Compile Include="..\..\src\ReStart.App\Services\ScriptTileSession.cs" Link="ScriptTileSession.cs" />
    <Compile Include="..\..\src\ReStart.App\Services\ScriptTileWorkerPool.cs" Link="ScriptTileWorkerPool.cs" />
    <Compile Include="..\..\src\ReStart.App\Services\SystemMetricsSampler.cs" Link="SystemMetricsSampler.cs" />
    <Compile Include="..\..\src\ReStart.App\Services\ScriptTilePackages.cs" Link="ScriptTilePackages.cs" />
    <Compile Include="..\..\src\ReStart.App\Services\WorkerJob.cs" Link="WorkerJob.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../examples/tiles/**/*" Link="Examples/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
