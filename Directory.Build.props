<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Keep portable RID restores separate from a developer's ordinary build. -->
    <BaseIntermediateOutputPath Condition="'$(RuntimeIdentifier)' != ''">obj/$(RuntimeIdentifier)/</BaseIntermediateOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/obj/**;**/bin/**</DefaultItemExcludes>
    <NuGetLockFilePath Condition="'$(RuntimeIdentifier)' != ''">$(MSBuildProjectDirectory)/obj/packages.$(RuntimeIdentifier).lock.json</NuGetLockFilePath>
    <Version>0.2.2</Version>
    <Authors>ReStart contributors</Authors>
    <RepositoryUrl>https://github.com/LastResolution/ReStart</RepositoryUrl>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
</Project>
