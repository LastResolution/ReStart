<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath Condition="'$(RuntimeIdentifier)' != ''">$(MSBuildProjectDirectory)/obj/packages.$(RuntimeIdentifier).lock.json</NuGetLockFilePath>
    <Version>0.1.1</Version>
    <Authors>ReStart contributors</Authors>
    <RepositoryUrl>https://github.com/LastResolution/ReStart</RepositoryUrl>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
</Project>
