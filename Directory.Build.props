<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- Developer paths must never enter redistributed PE debug directories. -->
    <PathMap>$(MSBuildThisFileDirectory)=/_/ReStart/</PathMap>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Keep portable RID restores separate from a developer's ordinary build. -->
    <BaseIntermediateOutputPath Condition="'$(RuntimeIdentifier)' != ''">obj/$(RuntimeIdentifier)/</BaseIntermediateOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/obj/**;**/bin/**</DefaultItemExcludes>
    <NuGetLockFilePath Condition="'$(RuntimeIdentifier)' != ''">$(MSBuildProjectDirectory)/obj/packages.$(RuntimeIdentifier).lock.json</NuGetLockFilePath>
    <Version>2.1.0</Version>
    <Authors>ReStart contributors</Authors>
    <Product>ReStart</Product>
    <RepositoryUrl>https://github.com/LastResolution/ReStart</RepositoryUrl>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
</Project>
