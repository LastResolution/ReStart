<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- Compile the documented Share cancellation event; keep the app's OS floor unchanged and gate the newer API at runtime. -->
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <!-- Keep the documented developer output location stable while targeting the Windows composition APIs. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin/$(Configuration)/net10.0-windows/</OutputPath>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF owns DPI via the manifest; WinForms is used only for tray/monitor APIs. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ReStart</AssemblyName>
    <ApplicationIcon>../../assets/ReStart.ico</ApplicationIcon>
    <Description>Windows 10 inspired full-screen Start for Windows 11.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ReStart.Core/ReStart.Core.csproj" />
    <ProjectReference Include="../ReStart.TileHost/ReStart.TileHost.csproj" ReferenceOutputAssembly="false" />
    <Content Include="../../examples/tiles/**/*" Link="Examples/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="../../assets/ReStart.png" Link="Assets/ReStart.png" />
    <EmbeddedResource Include="../../LICENSE" LogicalName="ReStart.Licenses.ReStart (MIT)" />
    <EmbeddedResource Include="../../third-party/*.txt" LogicalName="ReStart.Licenses.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets/Formatter/*.js" LogicalName="ReStart.Formatter.%(Filename)%(Extension)" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>
  <Target Name="CopyTileHost" AfterTargets="Build">
    <MSBuild Projects="../ReStart.TileHost/ReStart.TileHost.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_WorkerOutput" />
    </MSBuild>
    <PropertyGroup><_WorkerDirectory>@(_WorkerOutput->'%(RootDir)%(Directory)')</_WorkerDirectory></PropertyGroup>
    <ItemGroup><_WorkerFiles Include="$(_WorkerDirectory)ReStart.TileHost.exe;$(_WorkerDirectory)ReStart.TileHost.dll;$(_WorkerDirectory)ReStart.TileHost.deps.json;$(_WorkerDirectory)ReStart.TileHost.runtimeconfig.json;$(_WorkerDirectory)ReStart.Core.dll;$(_WorkerDirectory)Jint.dll;$(_WorkerDirectory)Acornima.dll" /></ItemGroup>
    <Copy SourceFiles="@(_WorkerFiles)" DestinationFolder="$(OutDir)TileHost" SkipUnchangedFiles="true" />
  </Target>
</Project>
